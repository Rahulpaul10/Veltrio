{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:testnet": "VITE_VELTRIO_NETWORK=testnet vite build --outDir dist-testnet",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "lint": "oxlint --type-aware src scripts --fix; s=$?; oxlint --fix .; exit $((s>0?s:$?))",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "test": "bun run scripts/test-units.ts && bun run scripts/test-flows.ts && bun run scripts/test-security.ts",
    "test:security": "bun run scripts/test-security.ts",
    "test:units": "bun run scripts/test-units.ts",
    "test:flows": "bun run scripts/test-flows.ts",
    "test:wallet": "bun run scripts/test-wallet.ts",
    "test:wallet:mainnet": "VITE_VELTRIO_NETWORK=mainnet bun run scripts/test-wallet.ts",
    "verify:network": "bun run scripts/verify-network.ts",
    "verify:docs": "bun run scripts/verify-docs.ts",
    "verify:history-provider": "bun run scripts/verify-history-provider.ts",
    "verify:release": "bun run scripts/verify-release.ts",
    "verify:deployed": "bun run scripts/check-deployed.ts"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.19.2",
    "@circle-fin/app-kit": "^1.18.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.1",
    "@circle-fin/user-controlled-wallets": "^10.8.1",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@openzeppelin/contracts": "5.6.1",
    "@tanstack/react-query": "^5.62.7",
    "@web3icons/react": "^4.0.0",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "2.57.5",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "2.57.5",
    "undici": "^6.29.1",
    "@grpc/grpc-js": "^1.13.6",
    "toml": "^5.0.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
